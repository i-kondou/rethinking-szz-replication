+  public boolean isHaveConnectionListener() {
+    return myHaveConnectionListener;
+  }
+
+  @Override
+  public void fireConnectionClosed() {
+    super.fireConnectionClosed();
+  }
+
+  @Override
+  public void fireConnectionOpened() {
+    super.fireConnectionOpened();
+  }
+}
