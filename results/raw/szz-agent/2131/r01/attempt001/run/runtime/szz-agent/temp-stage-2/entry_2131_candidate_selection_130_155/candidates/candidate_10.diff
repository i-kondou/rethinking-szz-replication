-      convertToRegexPattern("**/*~", caseSensitive),
-      convertToRegexPattern("**/#*#", caseSensitive),
-      convertToRegexPattern("**/.#*", caseSensitive),
-      convertToRegexPattern("**/%*%", caseSensitive),
-      convertToRegexPattern("**/._*", caseSensitive),
