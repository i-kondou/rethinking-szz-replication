-    for (Pattern includePattern : myIncludePatterns) {
-      if (includePattern.matcher(path).matches()) {
-        accepted = true;
-        break;
-      }
-    }
-    if (accepted) {
-      for (Pattern excludePattern : myExcludePatterns) {
-        if (excludePattern.matcher(path).matches()) {
-          accepted = false;
-          break;
-        }
-      }
