-    }
-
-    public Pattern getPattern() {
-      if (myCompiledPattern == null) {
-        myCompiledPattern = Pattern.compile(FileUtil.convertAntToRegexp(myStrPattern), myCaseSensitive ? 0 : Pattern.CASE_INSENSITIVE);
-      }
-      return myCompiledPattern;
-    }
-  }
-}
